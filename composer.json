{
    "name": "reestyle-it/number-class",
    "description": "Chainable numeric values, arithmetic, comparisons, trigonometry and currency formatting for PHP.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "files": [
            "src/helper.php"
        ],
        "psr-4": {
            "ReeStyleIt\\NumberClass\\": "src/",
            "ReeStyleIt\\NumberClass\\Enums\\": "src/enum/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Rafael den Heijer",
            "email": "rdheijer@reestyle.net"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "require-dev": {
        "pestphp/pest": "^5.3"
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "generate:symbols": "@php tools/generate-currency-symbols.php"
    },
    "require": {
        "php": "^8.4"
    },
    "keywords": [
        "number",
        "arithmetic",
        "math",
        "trigonometry",
        "currency",
        "formatting"
    ],
    "archive": {
        "exclude": [
            "/.github/",
            "/.idea/",
            "/.phpunit.cache/",
            "/tests/",
            "/vendor/",
            "/composer.lock",
            "/phpunit.xml",
            "/RELEASING.md",
            "/tools/"
        ]
    },
    "suggest": {
        "ext-intl": "Required for full currency amount formatting and ICU-backed currency symbol lookup."
    }
}
